PORT=3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SESSION_SECRET=replace-with-a-long-random-string

# Local/direct HTTP: keep these defaults.
# docker-compose.antblog.yml explicitly enables secure cookies + one trusted proxy.
COOKIE_SECURE=false
TRUST_PROXY=0

# Existing Docker network of the antblog stack (check docker network ls).
ANTBLOG_NETWORK=tech-knowledge-hub_tkh
